# Minimum packages for VPL jail system on Linux using DNF (fedora, etc.)
"LSB core" redhat-lsb-core
"make" make
"Autotools automake" automake
"Autotools autoconf" autoconf
"C compiler" gcc
"C++ compiler" gcc-c++
"SSL library" openssl		
"SSL library" openssl-devel	
"Firewall" iptables
GUI "Window manager" openbox fluxbox icewm
GUI "xterm" xterm
GUI "xset" xset
GUI "xauth" xorg-x11-xauth
GUI "VNC server" tigervnc-server-minimal
GUI "VNC server tools" tigervnc-server-common
