# Minimum packages for VPL jail system on Linux using APK (Alpine)
"make" make
"Autotools automake" automake
"Autotools autoconf" autoconf
"LSB" lsb-release-minimal
"C compiler" gcc
"C++ compiler" g++
"SSL library" openssl
"SSL library" openssl-dev
"Firewall" iptables
GUI "dbus-x11" dbus-x11
GUI "VNC server" tigervnc
GUI "Python XDG" py3-xdg
GUI "Window manager" openbox fluxbox icewm
GUI "X resource manager" xrdb
GUI "xterm" xterm
"net-tools" net-tools
"bc" bc
