# Minimum packages for VPL jail system on Linux using APT (Debian, Ubuntu, etc.)
"apt-utils" apt-utils
"make" make
"Autotools automake" automake
"Autotools autoconf" autoconf
"LSB" lsb lsb-core lsb-compat
"C++ compiler" g++
"SSL library" openssl
"SSL library" libssl-dev
"Firewall" iptables
GUI "dbus-x11" dbus-x11
GUI "VNC server" tigervnc-standalone-server tightvncserver
GUI "Window manager" openbox fluxbox icewm
GUI "xterm" xterm
"net-tools" net-tools
"bc" bc
